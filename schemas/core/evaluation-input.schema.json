              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_addressed_header_artifact_locator": {
          "anyOf": [
            {
              "type": "string",
              "format": "canonical-relative-path"
            },
            {
              "type": "null"
            }
          ]
