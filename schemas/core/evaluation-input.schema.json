        "canonical_locator": {
          "type": "string",
          "format": "canonical-relative-path"
        },
        "entry_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ReplayedRedirect": {
      "type": "object",
      "additionalProperties": false,
