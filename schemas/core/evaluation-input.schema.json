{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-skill.invalid/schemas/core/evaluation-input.schema.json",
  "title": "EvaluationInputBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "behavior_version",
    "evaluation_effective_at",
    "request_mode",
    "target_snapshot",
    "scenario_profile_id",
    "scenario_profiles",
    "candidate_universe",
    "journeys",
    "source_registry_refs",
    "evidence",
    "studies",
    "claims",
    "research_state",
    "adapter_evidence",
    "policy_digests",
    "snapshot_closure_result"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "evaluation-input-v1"
    },
    "behavior_version": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_mode": {
      "type": "string",
      "enum": [
        "guide",
        "scan",
        "refactor",
        "verify"
      ]
    },
    "target_snapshot": {
      "$ref": "#/$defs/TargetSnapshot"
    },
    "scenario_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScenarioProfile"
      }
    },
    "candidate_universe": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Solution"
      }
    },
    "journeys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Journey"
      }
    },
    "source_registry_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceArtifact"
      }
    },
    "studies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Study"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Claim"
      }
    },
    "research_state": {
      "$ref": "#/$defs/ResearchState"
    },
    "adapter_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AdapterEvidence"
      }
    },
    "policy_digests": {
      "$ref": "#/$defs/PolicyDigests"
    },
    "inquiry_draft": {
      "anyOf": [
        {
          "$ref": "#/$defs/InquiryDraft"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot_closure_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/SnapshotClosureResult"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "TargetSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_snapshot_id",
        "target_kind",
        "canonical_locator",
        "snapshot_digest"
      ],
      "properties": {
        "target_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "target_kind": {
          "type": "string",
          "enum": [
            "black_box_site",
            "pinned_repository",
            "hulianui_contract"
          ]
        },
        "canonical_locator": {
          "type": "string",
          "format": "canonical-relative-path"
        },
        "snapshot_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ScenarioProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_profile_id",
        "scenario_family_id"
      ],
      "properties": {
        "scenario_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "scenario_family_id": {
          "type": "string",
          "enum": [
            "admin-internal-tool",
            "ai-assisted-workflow",
            "brand-marketing-website",
            "consumer-transaction",
            "cross-channel-service",
            "developer-documentation",
            "public-service-information",
            "retail-commerce-discovery"
          ]
        }
      }
    },
    "Solution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solution_id",
        "option_ids"
      ],
      "properties": {
        "solution_id": {
          "type": "string",
          "minLength": 1
        },
        "option_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Journey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journey_id",
        "step_ids"
      ],
      "properties": {
        "journey_id": {
          "type": "string",
          "minLength": 1
        },
        "step_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "EvidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_kind",
        "artifact_digest",
        "source_ref"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "page-content",
            "runtime",
            "code",
            "component-contract",
            "research"
          ]
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_id",
        "study_kind",
        "execution_digest",
        "status"
      ],
      "properties": {
        "study_id": {
          "type": "string",
          "minLength": 1
        },
        "study_kind": {
          "type": "string",
          "enum": [
            "observational",
            "experimental",
            "research-review"
          ]
        },
        "execution_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "completed",
            "invalid"
          ]
        }
      }
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_kind",
        "relation_kind",
        "predicate_id",
        "population_id",
        "context_id",
        "time_scope_id",
        "subject_id",
        "value",
        "evidence_refs"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_kind": {
          "type": "string",
          "enum": [
            "normative",
            "causal",
            "predictive",
            "reported_experience",
            "observed_signal"
          ]
        },
        "relation_kind": {
          "type": "string",
          "enum": [
            "normative",
            "causal",
            "associational",
            "predictive",
            "descriptive",
            "reported_experience",
            "observed_signal",
            "unresolved"
          ]
        },
        "predicate_id": {
          "type": "string",
          "minLength": 1
        },
        "population_id": {
          "type": "string",
          "minLength": 1
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "time_scope_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ResearchState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_state_id",
        "status",
        "authorization_ref"
      ],
      "properties": {
        "research_state_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "not_requested",
            "planned",
            "authorized",
            "blocked",
            "completed"
          ]
        },
        "authorization_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AdapterEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_evidence_id",
        "adapter_contract_id",
        "artifact_digest"
      ],
      "properties": {
        "adapter_evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_contract_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "PolicyDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_policy_digest",
        "claim_policy_digest",
        "rule_registry_digest"
      ],
      "properties": {
        "decision_policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "claim_policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rule_registry_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "InquiryDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inquiry_draft_id",
        "text",
        "authoritative"
      ],
      "properties": {
        "inquiry_draft_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "authoritative": {
          "type": "boolean"
        }
      }
    },
    "EvaluationInputBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "behavior_version",
        "evaluation_effective_at",
        "request_mode",
        "target_snapshot",
        "scenario_profile_id",
        "scenario_profiles",
        "candidate_universe",
        "journeys",
        "source_registry_refs",
        "evidence",
        "studies",
        "claims",
        "research_state",
        "adapter_evidence",
        "policy_digests",
        "snapshot_closure_result"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "evaluation-input-v1"
        },
        "behavior_version": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "request_mode": {
          "type": "string",
          "enum": [
            "guide",
            "scan",
            "refactor",
            "verify"
          ]
        },
        "target_snapshot": {
          "$ref": "#/$defs/TargetSnapshot"
        },
        "scenario_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "scenario_profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenarioProfile"
          }
        },
        "candidate_universe": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Solution"
          }
        },
        "journeys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Journey"
          }
        },
        "source_registry_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceArtifact"
          }
        },
        "studies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Study"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          }
        },
        "research_state": {
          "$ref": "#/$defs/ResearchState"
        },
        "adapter_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AdapterEvidence"
          }
        },
        "policy_digests": {
          "$ref": "#/$defs/PolicyDigests"
        },
        "inquiry_draft": {
          "anyOf": [
            {
              "$ref": "#/$defs/InquiryDraft"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_closure_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/SnapshotClosureResult"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "HeaderItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "name_lower_ascii",
        "value_bytes_base64"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "name_lower_ascii": {
          "type": "string",
          "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$"
        },
        "value_bytes_base64": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    },
    "CanonicalResponseHeaders": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headers"
      ],
      "properties": {
        "headers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HeaderItem"
          }
        }
      }
    },
    "ReplayProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replay_profile_id",
        "viewport_width_css_px",
        "viewport_height_css_px",
        "device_scale_factor",
        "input_modality",
        "prefers_reduced_motion",
        "prefers_contrast",
        "color_scheme",
        "locale",
        "timezone",
        "assistive_technology_id",
        "browser_engine_digest"
      ],
      "properties": {
        "replay_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "viewport_width_css_px": {
          "type": "integer",
          "minimum": 1
        },
        "viewport_height_css_px": {
          "type": "integer",
          "minimum": 1
        },
        "device_scale_factor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "input_modality": {
          "type": "string",
          "enum": [
            "keyboard",
            "pointer",
            "touch"
          ]
        },
        "prefers_reduced_motion": {
          "type": "string",
          "enum": [
            "reduce",
            "no-preference"
          ]
        },
        "prefers_contrast": {
          "type": "string",
          "enum": [
            "no-preference",
            "more",
            "less",
            "custom"
          ]
        },
        "color_scheme": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "assistive_technology_id": {
          "type": "string",
          "minLength": 1
        },
        "browser_engine_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "RedirectHop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "status",
        "url",
        "location",
        "header_digest",
        "content_addressed_header_artifact_locator"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "location": {
          "type": "string",
          "format": "uri"
        },
        "header_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_addressed_header_artifact_locator": {
          "type": "string",
          "format": "canonical-relative-path"
        }
      }
    },
    "NetworkRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replay_profile_id",
        "sequence",
        "task_step_id",
        "request_method",
        "request_url",
        "redirect_chain",
        "final_url",
        "network_kind",
        "disposition",
        "response_status",
        "header_digest",
        "content_addressed_header_artifact_locator",
        "raw_body_digest",
        "content_addressed_body_artifact_locator"
      ],
      "properties": {
        "replay_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "task_step_id": {
          "type": "string",
          "minLength": 1
        },
        "request_method": {
          "type": "string",
          "enum": [
            "GET",
            "HEAD"
          ]
        },
        "request_url": {
          "type": "string",
          "format": "uri"
        },
        "redirect_chain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RedirectHop"
          }
        },
        "final_url": {
          "type": "string",
          "format": "uri"
        },
        "network_kind": {
          "type": "string",
          "enum": [
            "document",
            "script",
            "style",
            "image",
            "font",
            "xhr",
            "fetch",
            "other"
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "captured",
            "blocked_by_policy"
          ]
        },
        "response_status": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            {
              "type": "null"
            }
          ]
        },
        "header_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_addressed_header_artifact_locator": {
          "anyOf": [
            {
              "type": "string",
              "format": "canonical-relative-path"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_body_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_addressed_body_artifact_locator": {
          "anyOf": [
            {
              "type": "string",
              "format": "canonical-relative-path"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ObservationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replay_profile_id",
        "task_step_id",
        "evidence_kind",
        "ordinal",
        "artifact_digest",
        "content_addressed_artifact_locator"
      ],
      "properties": {
        "replay_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "task_step_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "screenshot",
            "dom_snapshot",
            "accessibility_tree",
            "interaction_trace",
            "performance_trace",
            "content_extract"
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_addressed_artifact_locator": {
          "type": "string",
          "format": "canonical-relative-path"
        }
      }
    },
    "SnapshotClosureManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closure_version",
        "entry_url",
        "task_script_digest",
        "capture_environment_digest",
        "captured_at",
        "authenticated",
        "replay_profiles",
        "network_records",
        "observation_records",
        "outbound_effect_ledger_digest",
        "completeness_status",
        "manifest_digest"
      ],
      "properties": {
        "closure_version": {
          "type": "string",
          "const": "snapshot-closure-v1"
        },
        "entry_url": {
          "type": "string",
          "format": "uri"
        },
        "task_script_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capture_environment_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "authenticated": {
          "type": "boolean"
        },
        "replay_profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReplayProfile"
          }
        },
        "network_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NetworkRecord"
          }
        },
        "observation_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObservationRecord"
          }
        },
        "outbound_effect_ledger_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "completeness_status": {
          "type": "string",
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "SnapshotCasArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "digest",
        "bytes_base64"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "format": "canonical-relative-path"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes_base64": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    },
    "SnapshotClosureSourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_snapshot_id",
        "target_kind",
        "canonical_locator",
        "entry_url",
        "snapshot_digest"
      ],
      "properties": {
        "target_snapshot_id": {
          "type": "string",
          "minLength": 1
