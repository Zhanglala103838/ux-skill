{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-skill.invalid/schemas/core/candidate-solver-input.schema.json",
  "title": "CandidateSolverInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_universe",
    "candidate_evaluations",
    "authority_status",
    "party_inventory_status",
    "safety_or_rights_floor_status"
  ],
  "properties": {
    "candidate_universe": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "https://ux-skill.invalid/schemas/core/evaluation-input.schema.json#/$defs/Solution"
      }
    },
    "candidate_evaluations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/CandidateEvaluation"
      }
    },
    "authority_status": {
      "type": "string",
      "enum": [
        "complete",
        "unknown"
      ]
    },
    "party_inventory_status": {
      "type": "string",
      "enum": [
        "unknown",
        "verified_complete",
        "verified_no_affected_party"
      ]
    },
    "safety_or_rights_floor_status": {
      "type": "string",
      "enum": [
        "not_applicable",
        "resolved",
        "unresolved",
        "triggered"
      ]
    },
    "evaluator_gate_binding": {
      "$ref": "#/$defs/EvaluatorGateBindingV1"
    }
  },
  "$defs": {
    "CandidateEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solution_id",
        "hard_constraints",
        "soft_dimensions"
      ],
      "properties": {
        "solution_id": {
          "type": "string",
          "minLength": 1
        },
        "hard_constraints": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/HardConstraintEvaluation"
          }
        },
        "soft_dimensions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/SoftDimensionEvaluation"
          }
        }
      }
    },
    "HardConstraintEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "result",
        "conflict_class"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "enum": [
            "E",
            "F",
            "T",
            "U"
          ]
        },
        "conflict_class": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SoftDimensionEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "party_or_cohort_id",
        "criterion",
        "tier",
        "value",
        "floor_result"
      ],
      "properties": {
        "party_or_cohort_id": {
          "type": "string",
          "minLength": 1
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": "number"
        },
        "floor_result": {
          "type": "string",
          "enum": [
            "E",
            "F",
            "T",
            "U"
          ]
        }
      }
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "CompletenessProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_id",
        "effect_scope_digest",
        "resource_scope_digest",
        "data_source_ids",
        "snapshot_digest",
        "snapshot_version",
        "effective_at",
        "expires_at",
        "closure_algorithm_id",
        "closure_algorithm_version",
        "verification_status",
        "completeness_proof_digest"
      ],
      "properties": {
        "proof_id": {
          "type": "string",
          "minLength": 1
        },
        "effect_scope_digest": {
          "$ref": "#/$defs/Digest"
        },
        "resource_scope_digest": {
          "$ref": "#/$defs/Digest"
        },
        "data_source_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "snapshot_digest": {
          "$ref": "#/$defs/Digest"
        },
        "snapshot_version": {
          "type": "string",
          "minLength": 1
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "closure_algorithm_id": {
          "type": "string",
          "minLength": 1
        },
        "closure_algorithm_version": {
          "type": "string",
          "minLength": 1
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "verified",
            "unknown"
          ]
        },
        "completeness_proof_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "AuthorityDecisionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_decision_id",
        "status",
        "candidate_universe_digest",
        "evaluation_effective_at",
        "policy_version",
        "proof_trace_digest",
        "authority_decision_digest"
      ],
      "properties": {
        "authorization_decision_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "unknown"
          ]
        },
        "candidate_universe_digest": {
          "$ref": "#/$defs/Digest"
        },
        "evaluation_effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "proof_trace_digest": {
          "$ref": "#/$defs/Digest"
        },
        "authority_decision_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "PartyInventoryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "party_inventory_id",
        "status",
        "party_ids",
        "candidate_universe_digest",
        "evaluation_effective_at",
        "policy_version",
        "completeness_proof_digest",
        "party_inventory_digest",
        "completeness_proof"
      ],
      "properties": {
        "party_inventory_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "verified_complete",
            "verified_no_affected_party"
          ]
        },
        "party_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidate_universe_digest": {
          "$ref": "#/$defs/Digest"
        },
        "evaluation_effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "completeness_proof_digest": {
          "$ref": "#/$defs/Digest"
        },
        "party_inventory_digest": {
          "$ref": "#/$defs/Digest"
        },
        "completeness_proof": {
          "$ref": "#/$defs/CompletenessProof"
        }
      }
    },
    "FloorAssessmentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_id",
        "status",
        "candidate_universe_digest",
        "candidate_evaluations_digest",
        "evaluation_effective_at",
        "policy_version",
        "assessment_digest"
      ],
      "properties": {
        "assessment_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "not_applicable",
            "resolved",
            "unresolved",
            "triggered"
          ]
        },
        "candidate_universe_digest": {
          "$ref": "#/$defs/Digest"
        },
        "candidate_evaluations_digest": {
          "$ref": "#/$defs/Digest"
        },
        "evaluation_effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "assessment_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "EvaluatorGateBindingV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_version",
        "evaluation_effective_at",
        "policy_version",
        "candidate_universe_digest",
        "candidate_evaluations_digest",
        "authority_decision",
        "party_inventory",
        "safety_or_rights_floor_assessment",
        "issuer_id",
        "key_version",
        "algorithm",
        "signature_base64"
      ],
      "properties": {
        "binding_version": {
          "const": "EvaluatorGateBindingV1"
        },
        "evaluation_effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "candidate_universe_digest": {
          "$ref": "#/$defs/Digest"
        },
        "candidate_evaluations_digest": {
          "$ref": "#/$defs/Digest"
        },
        "authority_decision": {
          "$ref": "#/$defs/AuthorityDecisionBinding"
        },
        "party_inventory": {
          "$ref": "#/$defs/PartyInventoryBinding"
        },
        "safety_or_rights_floor_assessment": {
          "$ref": "#/$defs/FloorAssessmentBinding"
        },
        "issuer_id": {
          "type": "string",
          "minLength": 1
        },
        "key_version": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "signature_base64": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  }
}
