{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-skill.invalid/schemas/core/authority.schema.json",
  "title": "AuthorityBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority_roots",
    "acting_edges",
    "grants",
    "control_principal_edges",
    "party_graph_proofs",
    "party_inventories",
    "authorization_decisions",
    "execution_envelopes",
    "approval_decisions",
    "time_authority_policies",
    "capabilities",
    "capability_ledger_entries",
    "invalidations",
    "execution_leases",
    "external_effect_connectors"
  ],
  "properties": {
    "authority_roots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AuthorityRootRecord"
      }
    },
    "acting_edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ActingEdge"
      }
    },
    "grants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Grant"
      }
    },
    "control_principal_edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ControlPrincipalEdge"
      }
    },
    "party_graph_proofs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PartyEffectGraphCompletenessProof"
      }
    },
    "party_inventories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PartyInventory"
      }
    },
    "authorization_decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AuthorizationDecision"
      }
    },
    "execution_envelopes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExecutionEnvelope"
      }
    },
    "approval_decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ApprovalDecision"
      }
    },
    "time_authority_policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TimeAuthorityPolicy"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Capability"
      }
    },
    "capability_ledger_entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CapabilityLedgerEntry"
      }
    },
    "invalidations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/InvalidationRecord"
      }
    },
    "execution_leases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExecutionLease"
      }
    },
    "external_effect_connectors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExternalEffectConnector"
      }
    }
  },
  "$defs": {
    "ActorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace_uri",
        "issuer_id",
        "subject_id",
        "kind"
      ],
      "properties": {
        "namespace_uri": {
          "type": "string",
          "format": "uri"
        },
        "issuer_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "service",
            "organization",
            "agent"
          ]
        }
      }
    },
    "AuthorityScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions",
        "resource_types",
        "tenant_ids",
        "purposes"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resource_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tenant_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "purposes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "AuthorityRootRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_root_id",
        "issuer",
        "allowed_grant_scopes",
        "allowed_representation_scopes",
        "effective_at",
        "expires_at",
        "key_version",
        "revoked"
      ],
      "properties": {
        "authority_root_id": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "$ref": "#/$defs/ActorIdentity"
        },
        "allowed_grant_scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthorityScope"
          }
        },
        "allowed_representation_scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthorityScope"
          }
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "key_version": {
          "type": "string",
          "minLength": 1
        },
        "revoked": {
          "type": "boolean"
        }
      }
    },
    "ActingEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "sequence",
        "from",
        "to",
        "basis_ref",
        "scope",
        "effective_at",
        "expires_at",
        "version",
        "validity"
      ],
      "properties": {
        "edge_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "from": {
          "$ref": "#/$defs/ActorIdentity"
        },
        "to": {
          "$ref": "#/$defs/ActorIdentity"
        },
        "basis_ref": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/AuthorityScope"
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "validity": {
          "type": "string",
          "enum": [
            "verified",
            "rejected",
            "unknown"
          ]
        }
      }
    },
    "Grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_id",
        "issuer",
        "subject",
        "parent_grant_id",
        "scope",
        "effective_at",
        "expires_at",
        "status",
        "delegable",
        "remaining_depth",
        "epoch",
        "version",
        "proof_digest"
      ],
      "properties": {
        "grant_id": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "$ref": "#/$defs/ActorIdentity"
        },
        "subject": {
          "$ref": "#/$defs/ActorIdentity"
        },
        "parent_grant_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "$ref": "#/$defs/AuthorityScope"
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "revoked",
            "unknown"
          ]
        },
        "delegable": {
          "type": "boolean"
        },
        "remaining_depth": {
          "type": "integer",
          "minimum": 0
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "proof_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ControlPrincipalEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_edge_id",
        "from",
        "to",
        "basis_ref",
        "effective_at",
        "expires_at",
        "status"
      ],
      "properties": {
        "control_edge_id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "$ref": "#/$defs/ActorIdentity"
        },
        "to": {
          "$ref": "#/$defs/ActorIdentity"
        },
        "basis_ref": {
          "type": "string",
          "minLength": 1
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "rejected",
            "unknown"
          ]
        }
      }
    },
    "PartyEffectGraphCompletenessProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_id",
        "effect_scope_digest",
        "resource_scope_digest",
        "data_source_ids",
        "snapshot_digest",
        "snapshot_version",
        "effective_at",
        "expires_at",
        "closure_algorithm_id",
        "closure_algorithm_version",
        "verification_status"
      ],
      "properties": {
        "proof_id": {
          "type": "string",
          "minLength": 1
        },
        "effect_scope_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "resource_scope_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "data_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "snapshot_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot_version": {
          "type": "string",
          "minLength": 1
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "closure_algorithm_id": {
          "type": "string",
          "minLength": 1
        },
        "closure_algorithm_version": {
          "type": "string",
          "minLength": 1
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "verified",
            "rejected",
            "unknown"
          ]
        }
      }
    },
    "PartyInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "party_inventory_id",
        "status",
        "party_ids",
        "inventory_digest"
      ],
      "properties": {
        "party_inventory_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "verified_complete",
            "verified_no_affected_party",
            "unknown"
          ]
        },
        "party_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inventory_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "AuthorizationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_decision_id",
        "status",
        "effective_actor",
        "acting_chain_digest",
        "grant_chain_digest",
        "tenant_binding_set_digest",
        "reason_code"
      ],
      "properties": {
        "authorization_decision_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "continue",
            "block",
            "escalation",
            "invalid_input"
          ]
        },
        "effective_actor": {
          "$ref": "#/$defs/ActorIdentity"
        },
        "acting_chain_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "grant_chain_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tenant_binding_set_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "AuthorityBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_roots",
        "acting_edges",
        "grants",
        "control_principal_edges",
        "party_graph_proofs",
        "party_inventories",
        "authorization_decisions",
        "execution_envelopes",
        "approval_decisions",
        "time_authority_policies",
        "capabilities",
        "capability_ledger_entries",
        "invalidations",
        "execution_leases",
        "external_effect_connectors"
      ],
      "properties": {
        "authority_roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthorityRootRecord"
          }
        },
        "acting_edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActingEdge"
          }
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Grant"
          }
        },
        "control_principal_edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ControlPrincipalEdge"
          }
        },
        "party_graph_proofs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartyEffectGraphCompletenessProof"
          }
        },
        "party_inventories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartyInventory"
          }
        },
        "authorization_decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthorizationDecision"
          }
        },
        "execution_envelopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExecutionEnvelope"
          }
        },
        "approval_decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApprovalDecision"
          }
        },
        "time_authority_policies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimeAuthorityPolicy"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "capability_ledger_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityLedgerEntry"
          }
        },
        "invalidations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InvalidationRecord"
          }
        },
        "execution_leases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExecutionLease"
          }
        },
        "external_effect_connectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExternalEffectConnector"
          }
        }
      }
    },
    "ResourceVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "version"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ExecutionEnvelopeBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "payload_digest",
        "effect_digest",
        "precondition_digest",
        "postcondition_digest",
        "resource_versions",
        "tenant_set_digest",
        "authorization_purpose",
        "acting_chain_digest",
        "grant_chain_digest",
        "party_inventory_digest",
        "party_effect_graph_snapshot_digest",
        "party_effect_graph_snapshot_version",
        "party_graph_completeness_proof_digest",
        "time_authority_policy_digest",
        "journey_run_id",
        "journey_step_id",
        "channel",
        "audience"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "effect_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "precondition_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "postcondition_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "resource_versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceVersion"
          }
        },
        "tenant_set_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authorization_purpose": {
          "type": "string",
          "minLength": 1
        },
        "acting_chain_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "grant_chain_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "party_inventory_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "party_effect_graph_snapshot_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "party_effect_graph_snapshot_version": {
          "type": "string",
          "minLength": 1
        },
        "party_graph_completeness_proof_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "time_authority_policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "journey_run_id": {
          "type": "string",
          "minLength": 1
        },
        "journey_step_id": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "research_guard_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ExecutionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_id",
        "envelope_digest",
        "body"
      ],
      "properties": {
        "envelope_id": {
          "type": "string",
          "pattern": "^e_[0-9a-f]{32}$"
        },
        "envelope_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "body": {
          "$ref": "#/$defs/ExecutionEnvelopeBody"
        }
      }
    },
    "ApprovalDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_decision_id",
        "sequence",
        "approver_context_digest",
        "approver_authority_ref",
        "envelope_digest",
        "decision",
        "effective_at",
        "expires_at",
        "consumed"
      ],
      "properties": {
        "approval_decision_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "approver_context_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approver_authority_ref": {
          "type": "string",
          "minLength": 1
        },
        "envelope_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision": {
          "type": "string",
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "consumed": {
          "type": "boolean"
        }
      }
    },
    "TimeAuthorityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_authority_policy_id",
        "authority",
        "key_version",
        "clock_profile",
        "monotonic_profile",
        "effective_at",
        "expires_at",
        "policy_digest"
      ],
      "properties": {
        "time_authority_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "$ref": "#/$defs/ActorIdentity"
        },
        "key_version": {
          "type": "string",
          "minLength": 1
        },
        "clock_profile": {
          "type": "string",
          "minLength": 1
        },
        "monotonic_profile": {
          "type": "string",
          "minLength": 1
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "CapabilityBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "step_id",
        "acting_chain_digest",
        "session_id",
        "channel",
        "audience",
        "tenant_set_digest",
        "resource_versions",
        "authorization_purpose",
        "envelope_digest",
        "nonce",
        "expires_at",
        "issuer_id",
        "key_version",
        "capability_use"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "acting_chain_digest": {
          "type": "string",
