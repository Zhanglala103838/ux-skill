        },
        "request_mode": {
          "type": "string",
          "enum": [
            "guide",
            "scan",
            "refactor",
            "verify"
          ]
        },
        "bundle_base": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "behavior_version",
            "evaluation_effective_at",
            "target_snapshot",
            "scenario_profile_id"
          ],
          "properties": {
            "schema_version": {
              "type": "string",
              "minLength": 1
            },
            "behavior_version": {
              "type": "string",
              "minLength": 1
            },
            "evaluation_effective_at": {
              "type": "string",
              "format": "date-time"
            },
            "target_snapshot": {
              "type": "object",
              "additionalProperties": false,
              "required": [
