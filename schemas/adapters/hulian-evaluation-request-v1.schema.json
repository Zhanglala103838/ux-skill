                },
                "snapshot_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "scenario_profile_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "component_request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
