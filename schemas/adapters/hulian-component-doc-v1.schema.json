{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-skill.invalid/schemas/adapters/hulian-component-doc-v1.schema.json",
  "title": "HulianComponentDocV1",
  "description": "structuredContent of @hulianui/mcp get_component_doc with format=json. Captured from a running server by scripts/capture-hulian-fixture.mjs; never hand-written.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "components",
    "source"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "versionSkew": {
      "$ref": "#/$defs/VersionSkew"
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ComponentDoc"
      }
    },
    "source": {
      "$ref": "#/$defs/SourceInfo"
    }
  },
  "$defs": {
    "VersionSkew": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "source"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "NullableVersionSkew": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionSkew"
        },
        {
          "type": "null"
        }
      ]
    },
    "Staleness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stale",
        "reasons"
      ],
      "properties": {
        "stale": {
          "const": true
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "NullableString": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "Description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "SourceInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "origin",
        "version",
        "artifactVersion",
        "sourceVersion",
        "versionSkew",
        "generatedAt",
        "cacheTtlMs",
        "fallbacks",
        "stale"
      ],
      "properties": {
        "mode": {
          "enum": [
            "local",
            "remote"
          ]
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/NullableString"
        },
        "artifactVersion": {
          "$ref": "#/$defs/NullableString"
        },
        "sourceVersion": {
          "$ref": "#/$defs/NullableString"
        },
        "versionSkew": {
          "$ref": "#/$defs/NullableVersionSkew"
        },
        "generatedAt": {
          "$ref": "#/$defs/NullableString"
        },
        "cacheTtlMs": {
          "type": "integer",
          "minimum": 0
        },
        "artifactDigests": {
          "description": "Digests of the artifacts this one call actually read. Closed on purpose: get_component_doc with format=json reads llms-props.json and nothing else, so any other key is a response this contract was not written for.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "llms-props.json"
          ],
          "properties": {
            "llms-props.json": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "fallbacks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stale": {
          "anyOf": [
            {
              "$ref": "#/$defs/Staleness"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DocMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "description"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "valueType": {
          "type": "string",
          "minLength": 1
        },
        "resolvedType": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "$ref": "#/$defs/Description"
        }
      }
    },
    "ComponentDoc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "name",
        "category",
        "import",
        "exports",
        "doc",
        "props",
        "events",
        "slots"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "import": {
          "type": "string"
        },
        "exports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "doc": {
          "type": "string",
          "minLength": 1
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocMember"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocMember"
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocMember"
          }
        }
      }
    },
    "SourceArtifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "format": "canonical-relative-path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
