{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-skill.invalid/schemas/adapters/hulian-component-doc-v1.schema.json",
  "title": "HulianComponentDocV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_artifact",
    "components",
    "missing",
    "versionSkew",
    "stale",
    "fallbacks"
  ],
  "properties": {
    "source_artifact": {
      "$ref": "#/$defs/SourceArtifactIdentity"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ComponentDoc"
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "versionSkew": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "stale": {
      "type": "boolean"
    },
    "fallbacks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "DocMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "name",
        "kind",
        "required",
        "description"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ComponentDoc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "slug",
        "category",
        "import",
        "exports",
        "props",
        "events",
        "slots"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "import": {
          "type": "string"
        },
        "exports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocMember"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocMember"
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocMember"
          }
        }
      }
    },
    "SourceArtifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "format": "canonical-relative-path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "HulianComponentDocV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_artifact",
        "components",
        "missing",
        "versionSkew",
        "stale",
        "fallbacks"
      ],
      "properties": {
        "source_artifact": {
          "$ref": "#/$defs/SourceArtifactIdentity"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentDoc"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "versionSkew": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "stale": {
          "type": "boolean"
        },
        "fallbacks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
