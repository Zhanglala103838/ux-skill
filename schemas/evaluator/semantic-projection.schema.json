                "const": "associational"
              }
            },
            "required": [
              "admissible_conclusion"
            ]
          },
          "then": {
            "properties": {
              "assessed_predicate": {
                "$ref": "#/$defs/AssessedPredicateProjection"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "admissible_conclusion": {
                "const": "predictive"
              }
            },
            "required": [
              "admissible_conclusion"
            ]
          },
          "then": {
            "properties": {
              "assessed_predicate": {
                "$ref": "#/$defs/AssessedPredicateProjection"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "admissible_conclusion": {
                "const": "descriptive"
              }
            },
            "required": [
              "admissible_conclusion"
            ]
          },
          "then": {
            "properties": {
              "assessed_predicate": {
                "$ref": "#/$defs/AssessedPredicateProjection"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "admissible_conclusion": {
                "const": "reported_experience"
              }
            },
            "required": [
              "admissible_conclusion"
            ]
          },
          "then": {
            "properties": {
              "assessed_predicate": {
                "$ref": "#/$defs/AssessedPredicateProjection"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "admissible_conclusion": {
                "const": "observed_signal"
              }
            },
            "required": [
              "admissible_conclusion"
            ]
          },
          "then": {
            "properties": {
              "assessed_predicate": {
                "$ref": "#/$defs/AssessedPredicateProjection"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "admissible_conclusion": {
                "const": "unresolved"
              }
            },
            "required": [
              "admissible_conclusion"
            ]
          },
          "then": {
            "properties": {
              "assessed_predicate": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
