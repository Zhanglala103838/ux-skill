        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "admissible_conclusion": {
                "const": "normative"
              }
            },
            "required": [
              "admissible_conclusion"
            ]
          },
          "then": {
            "properties": {
              "assessed_predicate": {
                "$ref": "#/$defs/AssessedPredicateProjection"
              }
            }
          }
        },
        {
