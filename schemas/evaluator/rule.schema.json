{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-skill.invalid/schemas/evaluator/rule.schema.json",
  "title": "Rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "rule_version",
    "release_critical",
    "finding_type",
    "required_dependencies",
    "required_input_pointers",
    "applicability",
    "exclusion",
    "precondition",
    "check"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "rule_version": {
      "type": "string",
      "minLength": 1
    },
    "release_critical": {
      "type": "boolean"
    },
    "finding_type": {
      "type": "string",
      "minLength": 1
    },
    "required_dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ToolDependency"
      }
    },
    "required_input_pointers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applicability": {
      "$ref": "#/$defs/AstNode"
    },
    "exclusion": {
      "$ref": "#/$defs/AstNode"
    },
    "precondition": {
      "$ref": "#/$defs/AstNode"
    },
    "check": {
      "$ref": "#/$defs/AstNode"
    },
    "registered_input_pointers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "AstNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_id",
            "op",
            "value"
          ],
          "properties": {
            "node_id": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "const": "literal"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_id",
            "op",
            "path"
          ],
          "properties": {
            "node_id": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "const": "exists"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_id",
            "op",
            "path",
            "value"
          ],
          "properties": {
            "node_id": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "const": "eq"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": [
                "boolean",
                "string",
                "number",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_id",
            "op",
            "path",
            "value"
          ],
          "properties": {
            "node_id": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "const": "in"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": [
                "boolean",
                "string",
                "number",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_id",
            "op",
            "path",
            "operator",
            "value"
          ],
          "properties": {
            "node_id": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "const": "compare"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "type": "string",
              "enum": [
                "lt",
                "lte",
                "gt",
                "gte"
              ]
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_id",
            "op",
            "children"
          ],
          "properties": {
            "node_id": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "const": "all"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AstNode"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_id",
            "op",
            "children"
          ],
          "properties": {
            "node_id": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "const": "any"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AstNode"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_id",
            "op",
            "child"
          ],
          "properties": {
            "node_id": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "const": "not"
            },
            "child": {
              "$ref": "#/$defs/AstNode"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_id",
            "op",
            "invariant_id",
            "params"
          ],
          "properties": {
            "node_id": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "const": "builtin"
            },
            "invariant_id": {
              "type": "string",
              "minLength": 1
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {}
            }
          }
        }
      ]
    },
    "ToolDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_id",
        "required"
      ],
      "properties": {
        "dependency_id": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "Rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "rule_version",
        "release_critical",
        "finding_type",
        "required_dependencies",
        "required_input_pointers",
        "applicability",
        "exclusion",
        "precondition",
        "check"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "release_critical": {
          "type": "boolean"
        },
        "finding_type": {
          "type": "string",
          "minLength": 1
        },
        "required_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolDependency"
          }
        },
        "required_input_pointers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "applicability": {
          "$ref": "#/$defs/AstNode"
        },
        "exclusion": {
          "$ref": "#/$defs/AstNode"
        },
        "precondition": {
          "$ref": "#/$defs/AstNode"
        },
        "check": {
          "$ref": "#/$defs/AstNode"
        },
        "registered_input_pointers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}