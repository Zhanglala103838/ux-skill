          }
        },
        "run_issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunIssue"
          }
        },
        "claim_assessments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClaimAssessment"
          }
        },
        "risk_assessments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RiskAssessment"
          }
        },
        "recommendation_assessments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecommendationAssessment"
          }
        },
        "release_recommendation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseRecommendation"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution_traces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResolutionTrace"
          }
        },
        "inquiry_validation": {
          "anyOf": [
            {
              "$ref": "#/$defs/InquiryValidation"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage_gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CoverageGap"
          }
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Alternative"
          }
        },
        "solutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Solution"
          }
        },
        "unsat_cores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnsatCore"
          }
        }
      }
    },
    "ClaimKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate_id",
        "population_id",
        "context_id",
        "time_scope_id"
      ],
      "properties": {
        "predicate_id": {
          "type": "string",
          "minLength": 1
        },
        "population_id": {
          "type": "string",
          "minLength": 1
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "time_scope_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "FindingFingerprintV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "behavior_version",
        "rule_id",
        "rule_version",
        "finding_type",
        "emission_reason_code",
        "canonical_target_locator",
        "target_snapshot_digest",
        "scenario_binding_ids",
        "claim_key"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "behavior_version": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "finding_type": {
          "type": "string",
          "minLength": 1
        },
        "emission_reason_code": {
          "type": "string",
          "minLength": 1
        },
        "canonical_target_locator": {
          "type": "string",
          "minLength": 1
        },
        "target_snapshot_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scenario_binding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claim_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClaimKey"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AssessedPredicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation_kind",
            "subject_id",
            "value",
            "context_id",
            "time_scope_id",
            "predicate_id",
            "population_id"
          ],
          "properties": {
            "relation_kind": {
              "const": "normative"
            },
            "subject_id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "context_id": {
              "type": "string",
              "minLength": 1
            },
            "time_scope_id": {
              "type": "string",
              "minLength": 1
            },
            "predicate_id": {
              "type": "string",
              "minLength": 1
            },
            "population_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation_kind",
            "subject_id",
            "value",
            "context_id",
            "time_scope_id",
            "predicate_id",
            "population_id",
            "intervention_id",
            "counterfactual_id",
            "effect_estimand_id"
          ],
          "properties": {
            "relation_kind": {
              "const": "causal"
            },
            "subject_id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "context_id": {
              "type": "string",
