            },
            "intervention_id": {
              "type": "string",
              "minLength": 1
            },
            "counterfactual_id": {
              "type": "string",
              "minLength": 1
            },
            "effect_estimand_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation_kind",
            "subject_id",
            "value",
            "context_id",
            "time_scope_id",
            "predicate_id",
            "population_id"
          ],
          "properties": {
            "relation_kind": {
