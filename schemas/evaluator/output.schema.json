    "ClaimAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_assessment_id",
        "claim_id",
        "admissible_conclusion",
        "assessed_predicate",
        "evidence_grade",
        "check_results",
        "dimension_scores",
        "reason_codes"
      ],
      "properties": {
        "claim_assessment_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "admissible_conclusion": {
          "type": "string",
          "enum": [
            "normative",
            "causal",
            "associational",
            "predictive",
            "descriptive",
            "reported_experience",
            "observed_signal",
            "unresolved"
          ]
        },
        "assessed_predicate": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssessedPredicate"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_grade": {
          "type": "string",
          "enum": [
            "insufficient",
            "limited",
            "adequate",
            "high"
          ]
        },
        "check_results": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dimension_scores": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "admissible_conclusion": {
                "const": "normative"
              }
            },
            "required": [
              "admissible_conclusion"
            ]
          },
          "then": {
            "properties": {
              "assessed_predicate": {
                "$ref": "#/$defs/AssessedPredicate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "admissible_conclusion": {
                "const": "causal"
              }
            },
            "required": [
              "admissible_conclusion"
            ]
          },
          "then": {
            "properties": {
              "assessed_predicate": {
                "$ref": "#/$defs/AssessedPredicate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "admissible_conclusion": {
                "const": "associational"
              }
            },
            "required": [
              "admissible_conclusion"
            ]
          },
          "then": {
            "properties": {
              "assessed_predicate": {
                "$ref": "#/$defs/AssessedPredicate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "admissible_conclusion": {
                "const": "predictive"
              }
            },
            "required": [
              "admissible_conclusion"
            ]
          },
          "then": {
            "properties": {
              "assessed_predicate": {
                "$ref": "#/$defs/AssessedPredicate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "admissible_conclusion": {
